.pio_version 0
.program clocked_input

startup:
    set x, 7    
    mov osr, null
    mov isr, null
    wait 0 pin 2

get_size_byte:
    wait 0 pin 1
    wait 1 pin 1             
    in pins, 1;             
    jmp x--, get_size_byte
    wait 1 pin 2
    irq wait 0  

determine_usb_or_keyboard:
    pull block 
    mov y, osr ;get either usb packet or 0
    out null, 32
    irq wait 1 ; get irq 1 to show that data has been fetched
    jmp !y setting_count_for_usb                                               ; if data in and its not 0 then settubg count for usb
    jmp pin keyboard_setup ;should jmp if pin goes high, which indicates keyboard option 


setting_count_for_usb:
    wait 0 pin 2 ; if already low, then it wouldn't wait so it would pass through to set x, 7
    set x, 7 

usb_processing:
    wait 0 pin 1           ; a do while loop of sorts, it keeps 
    wait 1 pin 1
    in pins, 1             ; Shifts bit count bits from source into the INPUT SHIFT REGISTER 
    jmp x-- usb_processing ; goes through every byte size amounts of times. With autopush, should be otputting data everytime the RXFIFO is fulsize amounts of times. With autopush, should be otputting data everytime the RXFIFO is fulll
    jmp y-- setting_count_for_usb    ; this would have stored data from the mov y, osr which can only come from the mov y, osr
    wait 1 pin 2
    jmp startup  ; warning to jmp to initial setup if csn goes high

.wrap_target
keyboard_setup:
    wait 0 pin 2
    pull block
    mov x, osr 
    jmp !x startup

keyboard_processing: 
    wait 0 pin 1
    wait 1 pin 1
    out pins, 1
    jmp !OSRE keyboard_processing 
    wait 1 pin 2
.wrap

% c-sdk {
static inline void clocked_input_program_init(PIO pio, uint sm, uint offset, uint pin ) {
    pio_sm_config c = clocked_input_program_get_default_config(offset);

    // Recieving pin master to slave/Gary to a brown man
    sm_config_set_in_pins(&c, pin);  // reading data from the in pin(RX PIN) and use this to fill the isr. 
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 3, false); // Sets it as input. This is for all the pins listed above
    sm_config_set_in_shift(&c,false,true, 8); // keeps an eye on the data shifted into the isr, and once the threshold is reached(a byte) it outputs it to the RXFIFO 

    // pin      = data    1
    // pin + 1  = clock   2
    // pin + 2  = CSN     3

    // TX pin outputting when the csn goes low and when its time. This is for the keyboard 
    sm_config_set_out_pins(&c, pin + 3, 1);
    sm_config_set_jmp_pin(&c, pin + 4);
    pio_sm_set_consecutive_pindirs(pio, sm, pin + 3, 1, true);	
    sm_config_set_out_shift(&c,true,false, 8);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio,sm,true);

}

