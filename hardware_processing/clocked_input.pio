.pio_version 0

.program clocked_input

initial_setup:
    mov y, osr
    jmp check_csn

.wrap_target

constant_resets:
    set x, 7        ; 0 - 7 is 8 so this is byte range. Each clock transaction decrements this(line 19) so 
    push iffull

get_size_byte:
    wait 0 pin 1
    wait 1 pin 1
    in pins, 1
    jmp x-- get_size_byte    ; gets a byte of data in 
    mov x, isr  ; need to mov it first before pushing because after pushing the isr clears, so if i push early itll clear
    jmp x!=y usb_processing ; should then go to usb processing with size to loop that many times over it

    jmp keyboard_processing


check_csn:
    jmp pin initial_setup ; basically checks if csn has gone up or not

.wrap

usb_processing:
    jmp pin initial_setup  ; warning to jmp to initial setup if csn goes high
    wait 0 pin 1           ; a do while loop of sorts, it keeps 
    wait 1 pin 1
    in pins, 1 
    push iffull
    jmp x--, usb_processing
    jmp initial_setup

keyboard_processing:
    jmp pin initial_setup

    wait 0 pin 1
    wait 1 pin 1

    out pins, 1

    jmp keyboard_processing


% c-sdk {

static inline void clocked_input_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = clocked_input_program_get_default_config(offset);

    // Data pin
    sm_config_set_in_pins(&c, pin);

    // CSN pin
    sm_config_set_jmp_pin(&c, pin + 2);

    // TX pin
    sm_config_set_out_pins(&c, pin + 3, 1);

    // pin      = data    1
    // pin + 1  = clock   2
    // pin + 2  = CSN     3
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 3, false);

    // TX output pin
    pio_sm_set_consecutive_pindirs(pio, sm, pin + 3, 1, true);

    // Shift left (MSB-first)
    // IMPORTANT:
    // autopush DISABLED so first byte can be inspected

    sm_config_set_in_shift(&c, true, false, 8);

    // TX configuration
    sm_config_set_out_shift(&c, false, true, 8);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);

}

